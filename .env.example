# demo  = sample data in memory, "Viewing as" dropdown, no accounts. Resets on restart. (default)
# local = real accounts + data saved to a file, survives restarts. Needs a host with a disk that persists.
ANNA_DATA_MODE=demo
# Where local mode saves data (default data/anna.json). Keep this file private: it holds password hashes.
# ANNA_DATA_FILE=data/anna.json
